{
  "name": "highlight-editor",
  "version": "0.1.2",
  "description": "Soccer highlight reel editor for recruiting clips",
  "main": "./out/main/index.js",
  "author": "Matt",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.matt.highlighteditor",
    "productName": "Highlight Editor",
    "files": [
      "out/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "extraResources": [
        {
          "from": "build/hlp.icns",
          "to": "hlp.icns"
        }
      ],
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Highlight Reel Project",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.matt.highlighteditor.hlp"
            ],
            "CFBundleTypeExtensions": [
              "hlp"
            ],
            "CFBundleTypeIconFile": "hlp.icns"
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.matt.highlighteditor.hlp",
            "UTTypeDescription": "Highlight Reel Project",
            "UTTypeConformsTo": [
              "public.json",
              "public.data"
            ],
            "UTTypeIconFile": "hlp.icns",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "hlp"
              ]
            }
          }
        ]
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "hlp",
          "name": "Highlight Reel Project",
          "description": "Highlight Editor project",
          "role": "Editor",
          "icon": "hlp"
        }
      ]
    },
    "directories": {
      "buildResources": "build"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Highlight Editor",
      "artifactName": "Highlight-Editor-Setup-${version}.${ext}"
    },
    "afterPack": "build/afterPack.cjs"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "ffmpeg-static@5.3.0": true
  }
}
